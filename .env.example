# Copy to .env for local development. NEVER commit the real .env file.

# --- Core Django ---
# Required in production. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Europe/Sofia

# --- Production HTTPS (behind Nginx; see docs/AWS_DEPLOYMENT.md) ---
# Scheme-qualified origins for CSRF, e.g. https://laundry.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# During first-time certificate setup set redirect=false and HSTS=0;
# re-enable after HTTPS is confirmed working.
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=2592000

# --- Database ---
# "sqlite" for local development, "postgresql" in production.
DB_ENGINE=sqlite
POSTGRES_DB=dorm_laundry
POSTGRES_USER=dorm_laundry
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Email (Amazon SES SMTP in production; console backend is used when DEBUG) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=laundry@example.com

# --- Initial administrators (read once by `manage.py init_admins`) ---
# Supply at deployment time; remove from the environment afterwards.
ADMIN1_EMAIL=
ADMIN1_PASSWORD=
ADMIN1_FIRST_NAME=
ADMIN1_LAST_NAME=
ADMIN2_EMAIL=
ADMIN2_PASSWORD=
ADMIN2_FIRST_NAME=
ADMIN2_LAST_NAME=

# --- Lockbox PINs ---
# Fernet key for application-level PIN encryption and keyed duplicate
# fingerprints; independent of DJANGO_SECRET_KEY. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes stored PINs unreadable; back it up securely and never
# commit it. Rotating it requires re-importing the PIN inventory.
PIN_ENCRYPTION_KEY=
# Accepted PIN format (regex). Default: 4-8 digits. Match your lockbox hardware.
PIN_FORMAT_REGEX=^\d{4,8}$
